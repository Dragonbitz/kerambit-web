---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Closing from '../components/Closing.astro';
import Wip from '../components/Wip.astro';
import VimeoPlayer from '../components/VimeoPlayer.astro';
import { getVideo } from '../data/videos';

const showreel = getVideo('showreel');
---

<Base title="Trabajos" description="Showreel y películas en las que ha trabajado el equipo de stunts y diseño de acción KERAMBIT.">
  <PageIntro scene="04" title="Trabajos">
    <p>Una selección de nuestro trabajo en cine.</p>
  </PageIntro>

  <section class="works">
    <div class="wrap works__list">
      {showreel && <VimeoPlayer video={showreel} label="Toma 01" />}
    </div>
  </section>

  <Wip items={['Portadas de películas en las que hemos trabajado, u otros vídeos.']} />

  <Closing />
</Base>

<style>
  .works {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .works__list {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    max-width: 1080px;
  }
</style>
