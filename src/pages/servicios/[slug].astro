---
import Base from '../../layouts/Base.astro';
import Relay from '../../components/Relay.astro';
import Closing from '../../components/Closing.astro';
import Draft from '../../components/Draft.astro';
import VimeoPlayer from '../../components/VimeoPlayer.astro';
import { getVideo } from '../../data/videos';
import { servicios, type Servicio } from '../../data/servicios';

export function getStaticPaths() {
  return servicios.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Servicio };
const serviceVideos = (s.videos ?? []).map(getVideo).filter((v) => v !== undefined);
---

<Base title={s.titulo} description={s.resumen}>
  <section class="intro">
    <div class="wrap">
      <p class="mono intro__crumb"><a href="/servicios/">Servicios</a> · Tramo {s.tramo}</p>
      <h1 class="intro__title">{s.titulo}</h1>
      <p class="intro__lead">{s.intro}</p>
      {s.borrador && <Draft />}
    </div>
  </section>

  <section class="body">
    <div class="wrap body__grid">
      {s.secciones.map((sec, i) => (
        <article class="block">
          <p class="mono block__n">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="block__title">{sec.titulo}</h2>
          {sec.texto && <p class="block__text">{sec.texto}</p>}
          {sec.puntos && (
            <ul class="block__list">
              {sec.puntos.map((p) => <li>{p}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
    <div class="wrap">
      <aside class="ai">
        <p class="mono">Opción híbrida con IA</p>
        <p class="ai__text">{s.ia}</p>
      </aside>
    </div>
  </section>

  {serviceVideos.length > 0 && (
    <section class="works">
      <div class="wrap">
        <p class="mono works__label">Trabajos</p>
        <div class="works__grid">
          {serviceVideos.map((v, i) => <VimeoPlayer video={v} label={`Toma ${String(i + 1).padStart(2, '0')}`} />)}
        </div>
      </div>
    </section>
  )}

  <section class="relay-section">
    <div class="wrap">
      <p class="mono relay-section__label">El relevo completo</p>
      <Relay current={s.slug} />
    </div>
  </section>

  <Closing />
</Base>

<style>
  .intro {
    padding-block: calc(var(--header-h) + clamp(4rem, 9vw, 7rem)) clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line-soft);
  }
  .intro__crumb a {
    color: inherit;
    text-decoration: none;
  }
  .intro__crumb a:hover {
    color: var(--white);
  }
  .intro__title {
    margin-top: 1.25rem;
    font-size: clamp(2.8rem, 7.5vw, 6rem);
    max-width: 14ch;
  }
  .intro__lead {
    margin: 1.5rem 0 1.25rem;
    max-width: 52ch;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--text-muted);
  }
  .body {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .body__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .block {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
    display: grid;
    align-content: start;
    gap: 0.9rem;
  }
  .block__title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }
  .block__text {
    color: var(--text-muted);
    max-width: 46ch;
  }
  .block__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
    color: var(--text-muted);
  }
  .block__list li {
    padding-left: 1.4rem;
    position: relative;
  }
  .block__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.7rem;
    height: 1px;
    background: var(--text-dim);
  }
  .ai {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--bg-raised);
    border-left: 2px solid var(--white);
    display: grid;
    gap: 0.6rem;
  }
  .ai__text {
    font-size: 1.1rem;
    max-width: 60ch;
  }
  .works {
    padding-block: 0 clamp(3rem, 7vw, 5.5rem);
  }
  .works__label {
    margin-bottom: 1.5rem;
  }
  .works__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: clamp(2rem, 4vw, 3rem);
  }
  .relay-section {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--bg-alt);
    border-top: 1px solid var(--line-soft);
  }
  .relay-section__label {
    margin-bottom: 2rem;
  }
</style>
