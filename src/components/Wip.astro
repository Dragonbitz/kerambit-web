---
// Aviso de sección en preparación (solo durante la fase de pruebas).
import { ui } from '../i18n/ui';
interface Props {
  items?: string[];
}
const { items = [] } = Astro.props;
---

<section class="wip">
  <div class="wrap wip__inner">
    <p class="mono">— {ui.es.wip} —</p>
    {items.length > 0 && (
      <ul>
        {items.map((i) => <li>{i}</li>)}
      </ul>
    )}
  </div>
</section>

<style>
  .wip {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .wip__inner {
    border: 1px dashed var(--line);
    padding-block: 2rem;
    display: grid;
    gap: 1rem;
    max-width: calc(var(--max) - 2 * var(--gutter));
  }
  ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-dim);
  }
</style>
