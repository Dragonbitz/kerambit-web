---
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../config/site';
import { ui } from '../i18n/ui';

const t = ui.es;
const { email } = site.contact;
---

<div class="contact-buttons">
  <a class="btn btn--solid" href={whatsappUrl('Hola, quiero pedir presupuesto para un proyecto.')} target="_blank" rel="noopener">
    <Icon name="whatsapp" />
    {t.whatsapp}
  </a>
  <a class="btn email" href={`mailto:${email}`}>
    <Icon name="mail" />
    <span>{email}</span>
  </a>
</div>

<style>
  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .email {
    text-transform: none;
    letter-spacing: 0.04em;
  }
  @media (max-width: 480px) {
    .contact-buttons > .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
