---
interface Props {
  scene: string;
  title: string;
}
const { scene, title } = Astro.props;
---

<section class="intro">
  <div class="wrap">
    <p class="mono intro__scene">Escena {scene}</p>
    <h1 class="intro__title">{title}</h1>
    <div class="intro__body"><slot /></div>
  </div>
</section>

<style>
  .intro {
    padding-block: calc(var(--header-h) + clamp(4rem, 10vw, 8rem)) clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--grey-900);
  }
  .intro__scene {
    margin-bottom: 1.25rem;
  }
  .intro__title {
    font-size: clamp(3rem, 8vw, 6.5rem);
  }
  .intro__body {
    margin-top: 1.5rem;
    max-width: 56ch;
    color: var(--grey-300);
    font-size: 1.1rem;
  }
</style>
