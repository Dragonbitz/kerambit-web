---
// Vídeo de Vimeo que solo se carga al pulsar "Reproducir":
// la página no se hace más lenta y Vimeo no entra hasta que el visitante quiere ver el vídeo.
import Icon from './Icon.astro';
import { vimeoEmbedUrl, type Video } from '../data/videos';

interface Props {
  video: Video;
  label?: string;
}
const { video, label } = Astro.props;
---

<figure class="vplayer">
  <div class="vplayer__frame">
    <button class="vplayer__play" type="button" data-embed={vimeoEmbedUrl(video)} data-title={video.titulo}>
      <span class="vf vf--tl" aria-hidden="true"></span>
      <span class="vf vf--br" aria-hidden="true"></span>
      {label && <span class="mono vplayer__label">{label}</span>}
      <span class="vplayer__icon"><Icon name="play" /></span>
      <span class="vplayer__title">{video.titulo}</span>
      <span class="mono vplayer__cta">Reproducir</span>
    </button>
  </div>
  <figcaption class="vplayer__desc">{video.descripcion}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('.vplayer__play').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.embed ?? '';
      iframe.title = btn.dataset.title ?? 'Vídeo';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>

<style>
  .vplayer {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .vplayer__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-deep);
    border: 1px solid var(--line-soft);
    overflow: hidden;
  }
  .vplayer__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .vplayer__play {
    position: absolute;
    inset: 0;
    width: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.8rem;
    padding: 1.5rem;
    background: radial-gradient(ellipse at center, var(--bg-raised) 0%, var(--bg-deep) 75%);
    border: 0;
    color: var(--white);
    cursor: pointer;
    text-align: center;
  }
  .vplayer__icon {
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--white);
    border-radius: 50%;
    transition: background 0.3s var(--ease), color 0.3s var(--ease);
  }
  .vplayer__icon :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    margin-left: 3px;
  }
  .vplayer__play:hover .vplayer__icon {
    background: var(--white);
    color: var(--bg-deep);
  }
  .vplayer__title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    line-height: 1.1;
    max-width: 24ch;
  }
  .vplayer__cta {
    color: var(--text-dim);
  }
  .vplayer__label {
    position: absolute;
    top: 14px;
    left: 34px;
    font-size: 0.65rem;
    color: var(--text-dim);
  }
  .vf {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 0 solid rgb(242 242 240 / 0.45);
  }
  .vf--tl { top: 12px; left: 12px; border-top-width: 1px; border-left-width: 1px; }
  .vf--br { bottom: 12px; right: 12px; border-bottom-width: 1px; border-right-width: 1px; }
  .vplayer__desc {
    color: var(--text-muted);
    max-width: 60ch;
  }
</style>
