---
// Carrusel de carteles como una tira de película que avanza sola.
// Se puede deslizar con el dedo (o con el trackpad); al soltar, vuelve a avanzar al poco.
// Se pausa al pasar el ratón o al enfocar con teclado; no avanza solo si el usuario pide reducir movimiento.
import { peliculas } from '../data/peliculas';

// Copias de la lista para que la tira no deje huecos en pantallas anchas.
const COPIES = 4;
const copies = Array.from({ length: COPIES }, (_, i) => i);
---

<section class="strip" aria-label="Películas en las que hemos trabajado">
  <div class="strip__band" aria-hidden="true"></div>
  <div class="strip__viewport" data-copies={COPIES}>
    <ul class="strip__track">
      {copies.map((c) =>
        peliculas.map((p) => (
          <li class="film" aria-hidden={c > 0 ? 'true' : undefined}>
            <a href={p.imdb} target="_blank" rel="noopener" tabindex={c > 0 ? -1 : undefined} aria-label={`${p.titulo} en IMDb`}>
              <div class="film__poster">
                {p.cartel ? (
                  <img src={p.cartel} alt={`Cartel de ${p.titulo}`} width="300" height="450" loading="lazy" decoding="async" />
                ) : (
                  <div class="film__type">
                    <span class="film__type-title">{p.titulo}</span>
                    {p.estado && <span class="mono film__type-state">{p.estado}</span>}
                  </div>
                )}
              </div>
              <div class="film__meta">
                <span class="film__title">{p.titulo}</span>
                {p.anio && <span class="mono film__year">{p.anio}</span>}
              </div>
              {p.estado && <span class="mono film__state">{p.estado}</span>}
              <p class="film__work">{p.trabajo}</p>
            </a>
          </li>
        ))
      )}
    </ul>
  </div>
  <div class="strip__band" aria-hidden="true"></div>
</section>

<script>
  const SPEED = 35; // píxeles por segundo
  const RESUME_AFTER = 2500; // ms tras soltar el dedo

  document.querySelectorAll<HTMLElement>('.strip__viewport').forEach((vp) => {
    const track = vp.querySelector<HTMLElement>('.strip__track');
    if (!track) return;
    const copies = Number(vp.dataset.copies) || 1;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return; // sin avance automático; se puede deslizar a mano

    let copyWidth = track.scrollWidth / copies;
    let pos = copyWidth; // empezamos en la segunda copia para poder deslizar hacia los dos lados
    vp.scrollLeft = pos;

    let hovering = false;
    let touching = false;
    let focused = false;
    let visible = true;
    let resumeAt = 0;
    let last = performance.now();

    // Bucle sin costuras: si pasamos de una copia, saltamos una copia atrás (o adelante).
    const wrap = () => {
      if (vp.scrollLeft >= copyWidth * 2) vp.scrollLeft -= copyWidth;
      else if (vp.scrollLeft < copyWidth * 0.5) vp.scrollLeft += copyWidth;
    };

    const tick = (now: number) => {
      const dt = Math.min(now - last, 100) / 1000;
      last = now;
      const paused = hovering || touching || focused || !visible || now < resumeAt;
      if (!paused) {
        // `pos` guarda los decimales; el navegador redondea scrollLeft a píxeles.
        pos += SPEED * dt;
        if (pos >= copyWidth * 2) pos -= copyWidth;
        vp.scrollLeft = pos;
      } else {
        pos = vp.scrollLeft;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    // El usuario mueve la tira (dedo, trackpad o rueda): mantenemos el bucle y esperamos antes de seguir.
    vp.addEventListener('scroll', () => {
      if (touching || hovering) {
        wrap();
        resumeAt = performance.now() + RESUME_AFTER;
      }
    }, { passive: true });
    vp.addEventListener('touchstart', () => (touching = true), { passive: true });
    vp.addEventListener('touchend', () => {
      touching = false;
      resumeAt = performance.now() + RESUME_AFTER;
    }, { passive: true });
    vp.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && (hovering = true));
    vp.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && (hovering = false));
    vp.addEventListener('focusin', () => (focused = true));
    vp.addEventListener('focusout', () => (focused = false));
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(vp);
    window.addEventListener('resize', () => {
      copyWidth = track.scrollWidth / copies;
      wrap();
    });
  });
</script>

<style>
  .strip {
    background: var(--bg-deep);
    border-block: 1px solid var(--line-soft);
    overflow: hidden;
  }
  /* Perforaciones de la película */
  .strip__band {
    height: 22px;
    background: radial-gradient(circle at 50% 50%, var(--bg) 0 4px, transparent 4.5px) 0 50% / 26px 22px repeat-x,
      #111;
    opacity: 0.9;
  }
  .strip__viewport {
    padding-block: 1.75rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
  }
  .strip__viewport::-webkit-scrollbar {
    display: none;
  }
  .strip__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    width: max-content;
  }
  .film {
    width: clamp(180px, 20vw, 250px);
    margin-right: clamp(1.25rem, 2.5vw, 2rem);
    flex: none;
  }
  .film a {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
  }
  .film__poster {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-raised);
    border: 1px solid var(--line-soft);
  }
  .film__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .film a:hover .film__poster img,
  .film a:focus-visible .film__poster img {
    transform: scale(1.04);
  }
  .film__type {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 1.25rem;
    text-align: center;
    background: radial-gradient(ellipse at center, #333 0%, #161616 80%);
  }
  .film__type-title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .film__type-state {
    color: var(--text-dim);
    font-size: 0.65rem;
  }
  .film__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }
  .film__title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 1.15rem;
    line-height: 1.1;
  }
  .film__year {
    color: var(--text-dim);
    font-size: 0.65rem;
    white-space: nowrap;
  }
  .film__state {
    color: var(--text-dim);
    font-size: 0.65rem;
    margin-top: -0.3rem;
  }
  .film__work {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }
  @media (prefers-reduced-motion: reduce) {
    .film[aria-hidden='true'] {
      display: none;
    }
  }
</style>
