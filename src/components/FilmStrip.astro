---
// Carrusel de carteles como una tira de película que avanza sola.
// Se pausa al pasar el ratón o al enfocar con teclado; sin animación si el usuario pide reducir movimiento.
import { peliculas } from '../data/peliculas';

// Copias de la lista para que la tira no deje huecos en pantallas anchas.
const COPIES = 4;
const copies = Array.from({ length: COPIES }, (_, i) => i);
---

<section class="strip" aria-label="Películas en las que hemos trabajado">
  <div class="strip__band" aria-hidden="true"></div>
  <div class="strip__viewport">
    <ul class="strip__track" style={`--copies:${COPIES}; --items:${peliculas.length}`}>
      {copies.map((c) =>
        peliculas.map((p) => (
          <li class="film" aria-hidden={c > 0 ? 'true' : undefined}>
            <a href={p.imdb} target="_blank" rel="noopener" tabindex={c > 0 ? -1 : undefined} aria-label={`${p.titulo} en IMDb`}>
              <div class="film__poster">
                {p.cartel ? (
                  <img src={p.cartel} alt={`Cartel de ${p.titulo}`} width="300" height="450" loading="lazy" decoding="async" />
                ) : (
                  <div class="film__type">
                    <span class="film__type-title">{p.titulo}</span>
                    {p.estado && <span class="mono film__type-state">{p.estado}</span>}
                  </div>
                )}
              </div>
              <div class="film__meta">
                <span class="film__title">{p.titulo}</span>
                <span class="mono film__year">{p.anio ?? p.estado}</span>
              </div>
              <p class="film__work">{p.trabajo}</p>
            </a>
          </li>
        ))
      )}
    </ul>
  </div>
  <div class="strip__band" aria-hidden="true"></div>
</section>

<style>
  .strip {
    background: var(--bg-deep);
    border-block: 1px solid var(--line-soft);
    overflow: hidden;
  }
  /* Perforaciones de la película */
  .strip__band {
    height: 22px;
    background: radial-gradient(circle at 50% 50%, var(--bg) 0 4px, transparent 4.5px) 0 50% / 26px 22px repeat-x,
      #111;
    opacity: 0.9;
  }
  .strip__viewport {
    padding-block: 1.75rem;
    overflow: hidden;
  }
  .strip__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    width: max-content;
    animation: strip-run calc(var(--items) * 9s) linear infinite;
  }
  .strip:hover .strip__track,
  .strip:focus-within .strip__track {
    animation-play-state: paused;
  }
  @keyframes strip-run {
    to {
      transform: translateX(calc(-100% / var(--copies)));
    }
  }
  .film {
    width: clamp(180px, 20vw, 250px);
    margin-right: clamp(1.25rem, 2.5vw, 2rem);
    flex: none;
  }
  .film a {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
  }
  .film__poster {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-raised);
    border: 1px solid var(--line-soft);
  }
  .film__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .film a:hover .film__poster img,
  .film a:focus-visible .film__poster img {
    transform: scale(1.04);
  }
  .film__type {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 1.25rem;
    text-align: center;
    background: radial-gradient(ellipse at center, #333 0%, #161616 80%);
  }
  .film__type-title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .film__type-state {
    color: var(--text-dim);
    font-size: 0.65rem;
  }
  .film__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }
  .film__title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 1.15rem;
    line-height: 1.1;
  }
  .film__year {
    color: var(--text-dim);
    font-size: 0.65rem;
    white-space: nowrap;
  }
  .film__work {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }
  @media (prefers-reduced-motion: reduce) {
    .strip__track {
      animation: none;
    }
    .strip__viewport {
      overflow-x: auto;
    }
    .film[aria-hidden='true'] {
      display: none;
    }
  }
</style>
