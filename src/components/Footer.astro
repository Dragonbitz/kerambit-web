---
import { nav, ui } from '../i18n/ui';
import { site } from '../config/site';
import wordmark from '../assets/kerambit-wordmark.svg?raw';

const t = ui.es;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div>
      <p class="footer__brand" aria-label={`${site.name} Action Design`} set:html={wordmark} />
      <p class="footer__tag">{t.footerTagline}</p>
    </div>
    <ul class="footer__nav">
      {nav.es.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <p class="mono footer__meta">
      © {year} {site.name}
      <!-- PENDIENTE: enlaces a aviso legal y política de privacidad/cookies. -->
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line-soft);
    padding-block: 3rem;
    background: var(--bg-deep);
  }
  .footer__inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr auto;
    align-items: start;
  }
  .footer__brand {
    width: 11rem;
    margin-bottom: 0.75rem;
  }
  .footer__brand :global(svg) {
    width: 100%;
    height: auto;
  }
  .footer__tag {
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .footer__nav a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .footer__nav a:hover {
    color: var(--white);
  }
  .footer__meta {
    grid-column: 1 / -1;
    color: var(--text-dim);
  }
  @media (max-width: 700px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
