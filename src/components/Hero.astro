---
import ContactButtons from './ContactButtons.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';

const { loopVideo, poster, fullReel } = site.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <!-- El vídeo solo se carga si el navegador no pide ahorrar datos ni reducir movimiento. -->
    <video class="hero__video" data-src={loopVideo} poster={poster} muted loop playsinline preload="none"></video>
    <div class="hero__shade"></div>
  </div>

  <!-- Marcas de visor de cámara -->
  <div class="viewfinder" aria-hidden="true">
    <span class="vf vf--tl"></span><span class="vf vf--tr"></span>
    <span class="vf vf--bl"></span><span class="vf vf--br"></span>
    <span class="mono vf__label vf__label--tl">Toma 01</span>
    <span class="mono vf__label vf__label--tr"><i class="rec"></i><span data-timecode>00:00:00:00</span></span>
    <span class="mono vf__label vf__label--br">2.39 : 1</span>
  </div>

  <div class="hero__content wrap">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__line">Stunts y diseño de acción.</span>
      <span class="hero__choice">Rodaje clásico o híbrido con IA.</span>
    </h1>
    <!-- BORRADOR: subtítulo pendiente de pulir con Jose. -->
    <p class="hero__sub">
      Rodaje de siempre, o rodaje reforzado con IA donde reduce tiempo y riesgo. Lo decides escena a escena.
    </p>
    <div class="hero__actions">
      <ContactButtons />
      {fullReel && (
        <button class="btn hero__reel" type="button" data-open-reel>
          <Icon name="play" />
          Ver reel completo
        </button>
      )}
    </div>
  </div>

  {fullReel && (
    <dialog class="reel" aria-label="Reel de KERAMBIT">
      <button class="mono reel__close" type="button" data-close-reel>Cerrar</button>
      <video src={fullReel} controls playsinline preload="none"></video>
    </dialog>
  )}
</section>

<script>
  // Vídeo de portada: carga controlada.
  const video = document.querySelector<HTMLVideoElement>('.hero__video');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (video && !reduce && !saveData && video.dataset.src) {
    video.src = video.dataset.src;
    video.play().catch(() => {});
  }

  // Código de tiempo a 24 fps.
  const tc = document.querySelector<HTMLElement>('[data-timecode]');
  if (tc && !reduce) {
    const start = performance.now();
    const pad = (n: number) => String(n).padStart(2, '0');
    let last = -1;
    const tick = (now: number) => {
      const frames = Math.floor(((now - start) / 1000) * 24);
      if (frames !== last) {
        last = frames;
        const f = frames % 24;
        const s = Math.floor(frames / 24);
        tc.textContent = `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}:${pad(f)}`;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // Reel completo.
  const dialog = document.querySelector<HTMLDialogElement>('.reel');
  document.querySelector('[data-open-reel]')?.addEventListener('click', () => {
    dialog?.showModal();
    dialog?.querySelector('video')?.play();
  });
  const closeReel = () => {
    dialog?.querySelector('video')?.pause();
    dialog?.close();
  };
  document.querySelector('[data-close-reel]')?.addEventListener('click', closeReel);
  dialog?.addEventListener('click', (e) => e.target === dialog && closeReel());
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: calc(var(--header-h) + 3rem) clamp(4rem, 10vh, 7rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg-alt) url('/media/portada-provisional.jpg') center / cover no-repeat;
  }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(38 38 38 / 1) 0%, rgb(38 38 38 / 0.4) 55%, rgb(38 38 38 / 0.6) 100%);
  }

  .viewfinder {
    position: absolute;
    inset: calc(var(--header-h) + 0.5rem) var(--gutter) 1.5rem;
    pointer-events: none;
  }
  .vf {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 0 solid rgb(242 242 240 / 0.55);
  }
  .vf--tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .vf--tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
  .vf--bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .vf--br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }
  .vf__label {
    position: absolute;
    font-size: 0.7rem;
  }
  .vf__label--tl { top: 0.4rem; left: 2rem; }
  .vf__label--tr { top: 0.4rem; right: 2rem; display: flex; align-items: center; gap: 0.5rem; font-variant-numeric: tabular-nums; }
  .vf__label--br { bottom: 0.4rem; right: 2rem; }
  .rec {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--white);
    animation: blink 1.2s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero__content {
    position: relative;
  }
  .hero__title {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .hero__line {
    font-size: clamp(3rem, 9vw, 7.5rem);
    max-width: 12ch;
  }
  .hero__choice {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    letter-spacing: 0.02em;
    color: var(--text-muted);
    text-wrap: balance;
  }
  .hero__sub {
    margin-top: 1.5rem;
    max-width: 46ch;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
  }
  .hero__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .reel {
    width: min(92vw, 1280px);
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--white);
  }
  .reel::backdrop {
    background: rgb(0 0 0 / 0.9);
  }
  .reel video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .reel__close {
    position: absolute;
    top: -2.25rem;
    right: 0;
    background: none;
    border: 0;
    color: var(--white);
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .vf__label--br {
      display: none;
    }
  }
</style>
