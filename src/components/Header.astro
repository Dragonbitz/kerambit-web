---
import { nav, ui } from '../i18n/ui';
import { site } from '../config/site';

const t = ui.es;
const links = nav.es;
const current = Astro.url.pathname;
---

<header class="header">
  <div class="header__inner wrap">
    <!-- PENDIENTE: sustituir el texto por el logo en SVG (K con dos kerambits). -->
    <a class="logo" href="/" aria-label={`${site.name}, inicio`}>
      <span class="logo__k">K</span><span class="logo__rest">ERAMBIT</span>
    </a>

    <button class="menu-btn mono" type="button" aria-expanded="false" aria-controls="nav">
      <span class="menu-btn__open">{t.menu}</span>
      <span class="menu-btn__close">{t.close}</span>
    </button>

    <nav id="nav" class="nav" aria-label="Principal">
      <ul>
        {links.map((l, i) => (
          <li>
            <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined}>
              <span class="mono nav__num">{String(i + 1).padStart(2, '0')}</span>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    document.documentElement.classList.toggle('nav-open', !open);
  });
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    background: linear-gradient(to bottom, rgb(10 10 10 / 0.75), transparent);
  }
  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: 0.32em;
    text-decoration: none;
    position: relative;
    z-index: 2;
  }
  .logo__k {
    letter-spacing: 0.12em;
  }
  .nav ul {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--grey-300);
    transition: color 0.3s var(--ease);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--white);
  }
  .nav__num {
    font-size: 0.65rem;
    color: var(--grey-500);
  }
  .menu-btn {
    display: none;
    background: none;
    border: 1px solid var(--grey-700);
    color: var(--white);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    position: relative;
    z-index: 2;
  }
  .menu-btn__close {
    display: none;
  }

  @media (max-width: 820px) {
    .menu-btn {
      display: block;
    }
    .nav {
      position: fixed;
      inset: 0;
      background: var(--black);
      display: flex;
      align-items: center;
      padding: var(--gutter);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.35s var(--ease),
        visibility 0.35s;
    }
    .nav ul {
      flex-direction: column;
      gap: 1.25rem;
    }
    .nav a {
      font-size: 2.4rem;
      color: var(--white);
    }
    :global(.nav-open) .nav {
      opacity: 1;
      visibility: visible;
    }
    :global(.nav-open) .menu-btn__open {
      display: none;
    }
    :global(.nav-open) .menu-btn__close {
      display: inline;
    }
    :global(.nav-open) body {
      overflow: hidden;
    }
  }
</style>
